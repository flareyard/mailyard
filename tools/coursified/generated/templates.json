    "subject": "You hit {{trigger.used}} of {{trigger.limit}} conversions this month",
    "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light\">\n<title>Coursified</title>\n<style>\n/* Webfonts load where the client allows them (Apple Mail, iOS Mail,\n   Outlook macOS). Gmail and Outlook Windows strip webfonts entirely and\n   fall back to the Helvetica/Arial stacks — no email can change that. */\n@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600&family=Figtree:wght@400;500;600&display=swap');\n</style>\n<style>\n@media only screen and (max-width:480px){\n  .em-pad{padding-left:20px !important;padding-right:20px !important}\n  .em-panel{padding-left:20px !important;padding-right:20px !important}\n  .em-h1{font-size:21px !important}\n  .em-hero{font-size:23px !important}\n  .em-code{font-size:24px !important}\n  .em-btn{display:block !important;text-align:center !important}\n}\n</style>\n</head>\n<body style=\"margin:0;padding:0;background-color:#ECECEA;\">\n<div style=\"display:none;max-height:0;overflow:hidden;mso-hide:all;\">Pro is unlimited — and your next video is waiting.&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#ECECEA;\">\n<tr><td align=\"center\" style=\"padding:24px 12px;\">\n<table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;max-width:600px;background-color:#FFFFFF;border-radius:16px;\">\n<tr><td class=\"em-pad\" style=\"padding:24px 36px;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr>\n<td style=\"font-family:'Figtree','Segoe UI','Helvetica Neue',Helvetica,Arial,sans-serif;font-weight:600;font-size:15px;color:#0E0E0E;\"><span style=\"display:inline-block;width:16px;heigh