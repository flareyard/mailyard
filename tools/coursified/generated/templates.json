t-size:1px;\">&nbsp;</td>\n<td align=\"center\" style=\"vertical-align:middle;white-space:nowrap;\">\n<div style=\"font-family:'Outfit','Century Gothic','Trebuchet MS','Segoe UI',Arial,sans-serif;font-size:30px;font-weight:500;color:#FFFFFF;\">{{#if trigger.priceLabel}}{{trigger.priceLabel}}{{else}}$9{{/if}}</div>\n<div style=\"font-family:'Figtree','Segoe UI','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11px;color:#B8B8B4;\">/month, yearly</div>\n<a href=\"{{trigger.upgradeUrl}}\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"display:inline-block;margin-top:10px;padding:11px 18px;border-radius:10px;background-color:#2E5BFF;color:#FFFFFF;font-family:'Figtree','Segoe UI','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;font-weight:600;text-decoration:none;\">Go Pro</a>\n</td></tr></table>\n</td></tr></table><p style=\"margin:14px 0 0;font-family:'Figtree',Helvetica,Arial,sans-serif;font-size:12.5px;line-height:1.6;color:#8A8A86;\">Or wait — your free conversions reset on <b style=\"color:#0E0E0E;\">{{trigger.resetDateLabel}}</b>. Your queued video stays saved either way.</p><div style=\"height:30px;font-size:1px;line-height:30px;\">&nbsp;</div></div></td></tr>\n<tr><td class=\"em-pad\" style=\"padding:18px 36px;border-top:1px solid #F0F0EE;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr>\n<td style=\"font-family:'Figtree','Segoe UI','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11.5px;color:#8A8A86;line-height:1.5;\">Sent once per limit hit — never more.</td>\n<td align=\"right\" style=\"font-family:'Figtree','Segoe UI','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11.5px;color:#8A8A86;white-space:nowrap;padding-left:14px;\"><a href=\"{{unsubscribe_url}}\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#8A8A86;text-decoration:underline;\">Unsubscribe</a></td>\n</tr></table>\n</td></tr>\n</table>\n</td></tr>\n</table>\n</body>\n</html>",
    "text": "{{trigger.usedWord}} for {{trigger.limitWord}}. That's the good problem.\n\nYou used all {{trigger.limit}} free conversions this month — and you finished what you converted. Pro removes the ceiling:\n\n✓ Unlimited conversions & playlists\n✓ Priority processing (~1 min)\n✓ All certificate templates\n✓ Advanced quiz types\n\n{{#if trigger.priceLabel}}{{trigger.priceLabel}}{{else}}$9{{/if}}/month, yearly — Go Pro: {{trigger.upgradeUrl}}\n\nOr wait — your free conversions reset on {{trigger.resetDateLabel}}. Your queued video stays saved either way.\n\n—\nSent once per limit hit — never more.\nCoursified · coursified.app · hello@coursified.app"
