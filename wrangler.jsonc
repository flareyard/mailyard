{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mailyard-api",
  "main": "src/workers/api.ts",
  "compatibility_date": "2026-10-16",
  // No resource ids: `wrangler deploy` provisions D1, R2 and the queues in whichever account deploys, and
  // keeps them linked by name. Don't commit the ids wrangler writes back after a deploy.
  "d1_databases": [{ "binding": "DB", "database_name": "mailyard", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "STORE", "bucket_name": "mailyard-store" }],
  "send_email": [{ "name": "EMAIL" }],
  "durable_objects": {
    "bindings": [{ "name": "MAILBOX", "class_name": "MailboxDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MailboxDO"] }],
  "workflows": [
    {
      "name": "mailyard-mailbox-import",
      "binding": "IMPORT_WORKFLOW",
      "class_name": "MailboxImportWorkflow"
    },
    { "name": "mailyard-mailbox-export", "binding": "EXPORT_WORKFLOW", "class_name": "MailboxExportWorkflow" }
  ],
  "queues": {
    "producers": [
      { "binding": "SEND_QUEUE", "queue": "mailyard-send" },
      { "binding": "WEBHOOK_QUEUE", "queue": "mailyard-webhooks" },
      { "binding": "INBOUND_QUEUE", "queue": "mailyard-inbound" },
      { "binding": "MAILBOX_SEND_QUEUE", "queue": "mailyard-mailbox-send" }
    ],
    "consumers": [
      {
        "queue": "mailyard-send",
        "max_batch_size": 10,
        "max_retries": 10,
        "dead_letter_queue": "mailyard-send-dlq"
      },
      {
        // Email Sending delivery events (event subscription on the account).
        "queue": "mailyard-email-events",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "dead_letter_queue": "mailyard-email-events-dlq"
      },
      {
        "queue": "mailyard-webhooks",
        "max_batch_size": 10,
        "max_retries": 10,
        "dead_letter_queue": "mailyard-webhooks-dlq"
      },
      {
        // Inbound messages whose filing failed after the raw copy was stored. The ledger row stays
        // `failed` after the last retry and can be reprocessed from POST /v1/inbound/{id}/reprocess.
        "queue": "mailyard-inbound",
        "max_batch_size": 5,
        "max_retries": 10,
        "dead_letter_queue": "mailyard-inbound-dlq"
      },
      {
        // Drafts a mailbox's alarm found due (scheduled sends, and sends past their undo window).
        "queue": "mailyard-mailbox-send",
        "max_batch_size": 10,
        "max_retries": 10,
        "dead_letter_queue": "mailyard-mailbox-send-dlq"
      }
    ]
  },
  "observability": { "enabled": true }
}
