    "/v1/mailboxes/{id}/live": {
      "get": {
        "description": "Upgrade: websocket. Frames are JSON: hello { seq, schemaVersion, counts, labels }, then message.added, threads.changed, drafts.changed and counts, each with a seq. Reconnect with ?since=<seq>, or send {"type":"resume","since":n}, to replay what was missed: the frames, then resumed { since, seq, replayed }, or reset { seq, counts } when they're older than the kept 1,000 or a day. Send "ping" for "pong". A browser that can't set headers offers the subprotocols "mailyard.v1, bearer.<key>" instead of an Authorization header.",
        "operationId": "mail.live",
        "parameters": [
          {
            "description": "The mailbox.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "The last seq this client saw.",
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "type": "number",
            },
          },
        ],
        "responses": {
          "101": {
            "description": "Switching to the WebSocket.",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "properties": {
                        "message": {
                          "type": "string",
                        },
                        "reason": {
                          "type": "string",
                        },
                      },
                      "type": "object",
                    },
                  },
                  "type": "object",
                },
              },
            },
            "description": "No key, or not a key Mailyard knows.",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "properties": {
                        "message": {
                          "type": "string",
                        },
                        "reason": {
                          "type": "string",
                        },
                      },
                      "type": "object",
                    },
                  },
                  "type": "object",
                },
              },
            },
            "description": "No read access to the mailbox.",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "properties": {
                        "message": {
                          "type": "string",
                        },
                        "reason": {
                          "type": "string",
                        },
                      },
                      "type": "object",
                    },
                  },
                  "type": "object",
                },
              },
            },
            "description": "No such mailbox.",
          },
          "426": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "properties": {
                        "message": {
                          "type": "string",
                        },
                        "reason": {
                          "type": "string",
                        },
                      },
                      "type": "object",
                    },
                  },
                  "type": "object",
                },
              },
            },
            "description": "Not a WebSocket upgrade.",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Live changes over a WebSocket",
        "tags": [
          "mail",
        ],
      },
    },
