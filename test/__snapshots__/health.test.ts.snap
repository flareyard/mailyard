                              "contact",
                              "campaign",
                              "template",
                              "mailbox",
                              "domain",
                            ],
                            "type": "string",
                          },
                          "url": {
                            "description": "The web app's route for it.",
                            "type": "string",
                          },
                        },
                        "required": [
                          "type",
                          "id",
                          "title",
                          "subtitle",
                          "url",
