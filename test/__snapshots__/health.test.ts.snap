                                "type": "string",
                              },
                              {
                                "type": "null",
                              },
                            ],
                          },
                          "cfMessageId": {
                            "anyOf": [
                              {
                                "type": "string",
                              },
                              {
                                "type": "null",
                              },
                            ],
                          },
                          "clicks": {
                            "anyOf": [
                              {
                                "type": "number",
                              },
                              {
                                "enum": [
                                  "Infinity",
                                  "-Infinity",
                                  "NaN",
                                ],
                                "type": "string",
                              },
                            ],
                          },
                          "createdAt": {
                            "anyOf": [
                              {
                                "type": "number",
                              },
                              {
                                "enum": [
                                  "Infinity",
                                  "-Infinity",
                                  "NaN",
                                ],
                                "type": "string",
                              },
                            ],
                          },
                          "error": {
                            "anyOf": [
                              {
                                "type": "string",
                              },
                              {
                                "type": "null",
                              },
                            ],
                          },
                          "firstClickedAt": {
                            "anyOf": [
                              {
                                "anyOf": [
                                  {
                                    "type": "number",
                                  },
                                  {
                                    "enum": [
                                      "Infinity",
                                      "-Infinity",
                                      "NaN",
                                    ],
                                    "type": "string",
                                  },
                                ],
                              },
                              {
                                "type": "null",
                              },
                            ],
