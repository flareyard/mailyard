        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "messages": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "apiKeyId": {
                            "anyOf": [
                              {
                                "type": "string",
                              },
                              {
                                "type": "null",
                              },
                            ],
                          },
                          "attempts": {
                            "anyOf": [
                              {
                                "type": "number",
                              },
                              {
                                "enum": [
                                  "Infinity",
                                  "-Infinity",
                                  "NaN",
                                ],
                                "type": "string",
                              },
                            ],
                          },
