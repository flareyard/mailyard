            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "endpoint": {
                      "additionalProperties": false,
                      "properties": {
                        "createdAt": {
                          "anyOf": [
                            {
                              "type": "number",
                            },
                            {
                              "enum": [
                                "Infinity",
                                "-Infinity",
                                "NaN",
                              ],
                              "type": "string",
                            },
                          ],
                        },
                        "deadLetters": {
                          "anyOf": [
                            {
                              "type": "number",
                            },
                            {
                              "enum": [
                                "Infinity",
                                "-Infinity",
                                "NaN",
                              ],
