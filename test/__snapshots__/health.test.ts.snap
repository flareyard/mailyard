    "/v1/mailboxes/{id}/search": {
      "get": {
        "operationId": "mail.search",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "description": "Words (prefix matches), "phrases", and operators: from:, to:, cc:, subject:, body:, in:<folder>, label:, is:unread, is:starred, has:attachment, before:YYYY-MM-DD, after:YYYY-MM-DD (inclusive). Unknown operators are searched as words and listed in parsed.unsupported.",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "enum": [
                "recent",
                "relevance",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "hits": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "excerpt": {
                            "type": "string",
                          },
                          "folder": {
                            "enum": [
                              "inbox",
                              "archive",
                              "sent",
                              "spam",
                              "trash",
                              "snoozed",
                            ],
                            "type": "string",
                          },
                          "from": {
                            "anyOf": [
                              {
                                "additionalProperties": false,
                                "properties": {
                                  "address": {
                                    "type": "string",
                                  },
                                  "name": {
                                    "anyOf": [
                                      {
                                        "type": "string",
                                      },
                                      {
                                        "type": "null",
                                      },
                                    ],
                                  },
                                },
                                "required": [
                                  "name",
                                  "address",
                                ],
                                "type": "object",
                              },
                              {
                                "type": "null",
                              },
                            ],
                          },
                          "messageId": {
                            "type": "string",
                          },
                          "rank": {
                            "anyOf": [
                              {
                                "type": "number",
                              },
                              {
                                "enum": [
                                  "Infinity",
                                  "-Infinity",
                                  "NaN",
                                ],
                                "type": "string",
                              },
                            ],
                          },
                          "receivedAt": {
                            "anyOf": [
                              {
                                "type": "number",
                              },
                              {
                                "enum": [
                                  "Infinity",
                                  "-Infinity",
                                  "NaN",
                                ],
                                "type": "string",
                              },
                            ],
                          },
                          "subject": {
                            "type": "string",
                          },
                          "subjectHighlighted": {
                            "description": "The subject with matches wrapped in U+0002 … U+0003, as excerpt is.",
                            "type": "string",
                          },
                          "threadId": {
                            "type": "string",
                          },
                        },
                        "required": [
                          "messageId",
                          "threadId",
                          "folder",
                          "from",
                          "receivedAt",
                          "subject",
                          "subjectHighlighted",
                          "excerpt",
                          "rank",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "parsed": {
                      "additionalProperties": false,
                      "description": "What the query was understood as, for the search bar to show as chips.",
                      "properties": {
                        "operators": {
                          "items": {
                            "additionalProperties": false,
                            "properties": {
                              "op": {
                                "type": "string",
                              },
                              "value": {
                                "type": "string",
                              },
                            },
                            "required": [
