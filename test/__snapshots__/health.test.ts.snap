                                {
                                  "additionalProperties": false,
                                  "properties": {
                                    "type": {
                                      "enum": [
                                        "archive",
                                        "trash",
                                        "spam",
                                        "markRead",
                                        "star",
                                        "skipSpamCheck",
                                      ],
                                      "type": "string",
                                    },
                                  },
                                  "required": [
                                    "type",
                                  ],
                                  "type": "object",
                                },
                                {
                                  "additionalProperties": false,
                                  "properties": {
                                    "to": {
                                      "items": {
                                        "type": "string",
                                      },
                                      "maxItems": 10,
                                      "minItems": 1,
                                      "type": "array",
                                    },
                                    "type": {
                                      "enum": [
                                        "forward",
                                      ],
                                      "type": "string",
                                    },
                                  },
