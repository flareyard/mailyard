                            },
                          ],
                        },
                        "description": {
                          "anyOf": [
                            {
                              "type": "string",
                            },
                            {
                              "type": "null",
                            },
                          ],
                        },
                        "enabled": {
                          "type": "boolean",
                        },
                        "events": {
                          "items": {
                            "anyOf": [
                              {
                                "description": "A webhook event. Deliveries carry Standard Webhooks headers: webhook-id, webhook-timestamp and webhook-signature (v1,<base64 HMAC-SHA256 of "id.timestamp.body"> with the endpoint's whsec_ secret).",
                                "enum": [
                                  "message.sent",
                                  "message.delivered",
                                  "message.deferred",
                                  "message.bounced",
                                  "message.failed",
                                  "message.rejected",
                                  "message.complained",
                                  "email.opened",
                                  "email.clicked",
                                  "contact.created",
                                  "contact.updated",
                                  "contact.subscribed",
                                  "contact.unsubscribed",
                                  "contact.deleted",
                                  "contact.suppressed",
                                  "contact.unsuppressed",
                                  "event.tracked",
                                  "campaign.paused",
                                  "campaign.sent",
                                  "mail.received",
                                  "mail.rule_matched",
                                ],
                                "type": "string",
                              },
                              {
                                "enum": [
                                  "*",
                                ],
                                "type": "string",
                              },
                            ],
                          },
                          "type": "array",
                        },
                        "id": {
                          "type": "string",
                        },
                        "lastFailureAt": {
                          "anyOf": [
                            {
                              "anyOf": [
                                {
                                  "type": "number",
                                },
                                {
                                  "enum": [
                                    "Infinity",
                                    "-Infinity",
                                    "NaN",
                                  ],
                                  "type": "string",
                                },
                              ],
                            },
                            {
                              "type": "null",
                            },
                          ],
                        },
                        "lastSuccessAt": {
                          "anyOf": [
                            {
                              "anyOf": [
                                {
                                  "type": "number",
                                },
                                {
                                  "enum": [
                                    "Infinity",
                                    "-Infinity",
                                    "NaN",
                                  ],
                                  "type": "string",
                                },
                              ],
                            },
                            {
                              "type": "null",
                            },
                          ],
                        },
                        "updatedAt": {
                          "anyOf": [
                            {
                              "type": "number",
                            },
                            {
                              "enum": [
                                "Infinity",
                                "-Infinity",
                                "NaN",
                              ],
                              "type": "string",
                            },
                          ],
                        },
                        "url": {
                          "type": "string",
                        },
                      },
                      "required": [
                        "id",
                        "url",
                        "description",
                        "events",
                        "enabled",
                        "lastSuccessAt",
                        "lastFailureAt",
                        "deadLetters",
                        "createdAt",
                        "updatedAt",
                      ],
                      "type": "object",
                    },
