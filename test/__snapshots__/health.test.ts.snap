    "/v1/messages/{id}/raw": {
      "get": {
        "description": "Rebuilt as RFC 5322 from the copy Mailyard stored when it sent the message, with Email Service's Message-ID. Email Service builds the MIME it transmits and adds its own headers (DKIM-Signature, Received), so this is what Mailyard sent, not a capture of the wire.",
        "operationId": "messages.raw",
        "parameters": [
          {
            "description": "The message, as GET /v1/messages lists it.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "message/rfc822": {
                "schema": {
                  "format": "binary",
                  "type": "string",
                },
              },
            },
            "description": "The message.",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "properties": {
                        "message": {
                          "type": "string",
                        },
                        "reason": {
                          "type": "string",
                        },
                      },
                      "type": "object",
                    },
                  },
                  "type": "object",
                },
              },
            },
            "description": "No key, or not a key Mailyard knows.",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "properties": {
                        "message": {
                          "type": "string",
                        },
                        "reason": {
                          "type": "string",
                        },
                      },
                      "type": "object",
                    },
                  },
                  "type": "object",
                },
              },
            },
            "description": "A public key, or a key without the read scope.",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "properties": {
                        "message": {
                          "type": "string",
                        },
                        "reason": {
                          "type": "string",
                        },
                      },
                      "type": "object",
                    },
                  },
                  "type": "object",
                },
              },
            },
            "description": "No such message, or its copy is no longer stored.",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "A sent message's source (.eml)",
        "tags": [
          "messages",
        ],
      },
    },
