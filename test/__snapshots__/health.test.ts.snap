      "patch": {
        "operationId": "suppressions.update",
        "parameters": [
          {
            "in": "path",
            "name": "email",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "bulkOnly": {
                    "description": "True lets transactional mail through again (the way to treat a complaint); Cloudflare's account-wide entry is removed too, since it would block that mail.",
                    "type": "boolean",
                  },
                  "note": {
                    "anyOf": [
                      {
                        "maxLength": 1000,
                        "type": "string",
                      },
                      {
                        "type": "null",
                      },
                    ],
                  },
                },
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "cloudflare": {
                      "anyOf": [
                        {
                          "additionalProperties": false,
                          "description": "What happened on Cloudflare's list. removed: its entries for the address are gone. not-listed: it had none. read-only: Cloudflare keeps an entry nobody can delete, until it expires. not-connected: no write token, so Cloudflare may still refuse the address. failed: Cloudflare said no.",
                          "properties": {
                            "message": {
                              "anyOf": [
                                {
                                  "type": "string",
                                },
                                {
                                  "type": "null",
                                },
                              ],
                            },
                            "state": {
                              "enum": [
                                "removed",
                                "not-listed",
                                "read-only",
                                "not-connected",
                                "failed",
                              ],
                              "type": "string",
                            },
                          },
                          "required": [
                            "state",
                            "message",
                          ],
                          "type": "object",
                        },
                        {
                          "type": "null",
                        },
                      ],
                    },
                    "suppression": {
                      "additionalProperties": false,
                      "properties": {
                        "at": {
                          "anyOf": [
                            {
                              "type": "number",
                            },
                            {
                              "enum": [
                                "Infinity",
                                "-Infinity",
                                "NaN",
                              ],
                              "type": "string",
                            },
                          ],
                        },
                        "bulkOnly": {
                          "description": "Blocks only campaigns and automations; transactional and mailbox mail still go. Always true for unsubscribes.",
                          "type": "boolean",
                        },
                        "cloudflare": {
                          "description": "Whether Cloudflare's Email Sending suppression list agrees. in-sync: it has the address. missing: the last sync didn't find it (push it). not-applicable: an unsubscribe or bulk-only row, which Cloudflare's list must not hold, since it blocks transactional mail too. unchecked: no sync has looked yet, or Mailyard can't read the list.",
                          "enum": [
                            "in-sync",
                            "missing",
                            "not-applicable",
                            "unchecked",
                          ],
                          "type": "string",
                        },
                        "email": {
                          "type": "string",
                        },
                        "messageId": {
                          "anyOf": [
                            {
                              "type": "string",
                            },
                            {
                              "type": "null",
                            },
                          ],
                          "description": "The message whose bounce or complaint added it.",
                        },
                        "note": {
                          "anyOf": [
                            {
                              "type": "string",
                            },
                            {
                              "type": "null",
                            },
                          ],
                        },
                        "reason": {
                          "enum": [
                            "hard_bounce",
                            "complaint",
                            "unsubscribe",
                            "manual",
                          ],
                          "type": "string",
                        },
                        "source": {
                          "description": "events: a bounce or complaint event. cloudflare: Cloudflare refused a send, or the sync adopted it from Cloudflare's list. manual: added through the API. import: a suppression CSV.",
                          "enum": [
                            "cloudflare",
                            "events",
                            "manual",
                            "import",
                          ],
                          "type": "string",
                        },
                        "streams": {
                          "items": {
                            "enum": [
                              "all",
                              "campaign",
                              "automation",
                            ],
                            "type": "string",
                          },
                          "type": "array",
                        },
                        "updatedAt": {
                          "anyOf": [
                            {
                              "type": "number",
                            },
                            {
                              "enum": [
                                "Infinity",
                                "-Infinity",
                                "NaN",
                              ],
                              "type": "string",
                            },
                          ],
                        },
                      },
                      "required": [
