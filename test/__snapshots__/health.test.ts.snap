                                    "type",
                                    "to",
                                  ],
                                  "type": "object",
                                },
                                {
                                  "additionalProperties": false,
                                  "properties": {
                                    "body": {
                                      "maxLength": 20000,
                                      "minLength": 1,
                                      "type": "string",
                                    },
                                    "subject": {
                                      "maxLength": 998,
                                      "minLength": 1,
                                      "type": "string",
                                    },
                                    "type": {
                                      "enum": [
                                        "autoReply",
                                      ],
                                      "type": "string",
                                    },
                                  },
                                  "required": [
                                    "type",
                                    "subject",
                                    "body",
                                  ],
                                  "type": "object",
                                },
                                {
                                  "additionalProperties": false,
                                  "properties": {
                                    "endpointId": {
                                      "type": "string",
                                    },
                                    "type": {
                                      "enum": [
                                        "webhook",
                                      ],
                                      "type": "string",
