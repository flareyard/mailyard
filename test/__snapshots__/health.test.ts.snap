                                    "type": {
                                      "enum": [
                                        "assign",
                                      ],
                                      "type": "string",
                                    },
                                  },
                                  "required": [
                                    "type",
                                    "assignee",
                                  ],
                                  "type": "object",
                                },
                              ],
                            },
                            "type": "array",
                          },
                          "conditions": {
                            "items": {
                              "anyOf": [
                                {
                                  "additionalProperties": false,
                                  "properties": {
                                    "field": {
                                      "enum": [
                                        "from",
                                        "to",
                                        "cc",
                                        "recipients",
                                        "subject",
                                        "listId",
                                        "tag",
                                        "body",
                                      ],
