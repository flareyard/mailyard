    "/v1/uploads": {
      "post": {
        "description": "The request body is the file: a contact or suppression CSV, at most 50 MiB. Its Content-Type is kept. Answers an id that POST /v1/imports/contacts and POST /v1/suppressions/import take. Needs the admin scope.",
        "operationId": "uploads.create",
        "parameters": [
          {
            "description": "The file's name, without slashes. An x-filename header works too.",
            "in": "query",
            "name": "filename",
            "required": true,
            "schema": {
              "maxLength": 255,
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "*/*": {
              "schema": {
                "format": "binary",
                "type": "string",
              },
            },
          },
          "description": "The file's bytes.",
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "createdAt": {
                      "type": "number",
                    },
                    "filename": {
                      "type": "string",
                    },
                    "id": {
                      "type": "string",
                    },
                    "mimeType": {
                      "type": "string",
                    },
                    "sha256": {
                      "type": "string",
                    },
                    "size": {
                      "type": "number",
                    },
                  },
                  "required": [
                    "id",
                    "filename",
                    "mimeType",
                    "size",
                    "sha256",
                    "createdAt",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Stored.",
          },
          "400": {
            "content": {
