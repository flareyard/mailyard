    "/v1/mailboxes/{id}/threads": {
      "get": {
        "operationId": "mail.threads",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "folder",
            "required": false,
            "schema": {
              "description": "A folder, or all: every folder but spam and trash (All mail).",
              "enum": [
                "inbox",
                "archive",
                "sent",
                "spam",
                "trash",
                "snoozed",
                "all",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "labelId",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "unread",
            "required": false,
            "schema": {
              "enum": [
                "true",
                "false",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "starred",
            "required": false,
            "schema": {
              "enum": [
                "true",
                "false",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "assignee",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "nextCursor": {
                      "anyOf": [
                        {
                          "type": "string",
                        },
                        {
                          "type": "null",
                        },
                      ],
                    },
                    "threads": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "assignedTo": {
                            "anyOf": [
                              {
                                "additionalProperties": false,
                                "properties": {
                                  "id": {
                                    "type": "string",
                                  },
                                  "name": {
                                    "type": "string",
                                  },
                                },
                                "required": [
                                  "id",
                                  "name",
                                ],
                                "type": "object",
                              },
                              {
                                "type": "null",
                              },
                            ],
                            "description": "Who is handling it, with a name to show: the key's name until people exist (HAL-3361).",
                          },
                          "assignee": {
                            "anyOf": [
                              {
                                "type": "string",
                              },
                              {
                                "type": "null",
                              },
                            ],
                            "description": "The API key id handling it; see assignedTo for the name.",
                          },
                          "firstAt": {
                            "anyOf": [
                              {
                                "type": "number",
                              },
                              {
                                "enum": [
                                  "Infinity",
                                  "-Infinity",
                                  "NaN",
                                ],
                                "type": "string",
                              },
                            ],
                          },
                          "folders": {
                            "items": {
                              "enum": [
                                "inbox",
                                "archive",
                                "sent",
                                "spam",
                                "trash",
                                "snoozed",
                              ],
                              "type": "string",
                            },
                            "type": "array",
                          },
                          "hasAttachments": {
                            "type": "boolean",
                          },
                          "id": {
                            "type": "string",
                          },
                          "labelIds": {
                            "items": {
                              "type": "string",
                            },
                            "type": "array",
                          },
                          "lastAt": {
                            "anyOf": [
                              {
                                "type": "number",
                              },
                              {
                                "enum": [
                                  "Infinity",
                                  "-Infinity",
                                  "NaN",
                                ],
                                "type": "string",
                              },
                            ],
                          },
                          "latestMessageId": {
                            "type": "string",
                          },
                          "messageCount": {
                            "anyOf": [
                              {
                                "type": "number",
                              },
                              {
                                "enum": [
                                  "Infinity",
                                  "-Infinity",
                                  "NaN",
                                ],
                                "type": "string",
                              },
                            ],
                          },
                          "participants": {
                            "items": {
                              "additionalProperties": false,
                              "properties": {
                                "address": {
                                  "type": "string",
                                },
                                "name": {
                                  "anyOf": [
                                    {
                                      "type": "string",
                                    },
                                    {
                                      "type": "null",
                                    },
                                  ],
                                },
                              },
                              "required": [
                                "name",
                                "address",
                              ],
                              "type": "object",
                            },
                            "type": "array",
                          },
                          "scheduledSendAt": {
                            "anyOf": [
                              {
                                "anyOf": [
                                  {
                                    "type": "number",
                                  },
                                  {
                                    "enum": [
                                      "Infinity",
                                      "-Infinity",
                                      "NaN",
                                    ],
                                    "type": "string",
                                  },
                                ],
                              },
                              {
                                "type": "null",
                              },
                            ],
                            "description": "The earliest scheduled send of a reply in this conversation.",
                          },
                          "snippet": {
                            "type": "string",
                          },
                          "snoozedUntil": {
                            "anyOf": [
                              {
                                "anyOf": [
                                  {
                                    "type": "number",
                                  },
                                  {
                                    "enum": [
                                      "Infinity",
                                      "-Infinity",
                                      "NaN",
                                    ],
                                    "type": "string",
                                  },
                                ],
                              },
                              {
                                "type": "null",
                              },
                            ],
                          },
                          "sortAt": {
                            "anyOf": [
                              {
                                "type": "number",
                              },
                              {
                                "enum": [
                                  "Infinity",
                                  "-Infinity",
                                  "NaN",
                                ],
                                "type": "string",
                              },
                            ],
                          },
                          "spamScore": {
                            "anyOf": [
                              {
                                "anyOf": [
                                  {
                                    "type": "number",
                                  },
                                  {
                                    "enum": [
                                      "Infinity",
                                      "-Infinity",
                                      "NaN",
                                    ],
                                    "type": "string",
                                  },
                                ],
                              },
                              {
                                "type": "null",
                              },
                            ],
                            "description": "The highest spam score of its messages in spam; only when listing spam.",
                          },
                          "starred": {
                            "type": "boolean",
                          },
                          "subject": {
                            "type": "string",
                          },
                          "unreadCount": {
                            "anyOf": [
                              {
                                "type": "number",
                              },
                              {
                                "enum": [
                                  "Infinity",
                                  "-Infinity",
                                  "NaN",
                                ],
                                "type": "string",
                              },
                            ],
                          },
                        },
                        "required": [
                          "id",
                          "subject",
                          "snippet",
                          "latestMessageId",
                          "messageCount",
                          "unreadCount",
                          "starred",
                          "hasAttachments",
