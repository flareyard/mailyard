    "/v1/mailboxes/{id}/uploads": {
      "post": {
        "description": "The request body is the file, at most 25 MiB. Put the answered key in a draft's attachments; ones too big for Email Service's 5 MiB go as expiring links (see each draft attachment's delivery). Needs write access to the mailbox.",
        "operationId": "mail.upload",
        "parameters": [
          {
            "description": "The mailbox.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "The file's name, without slashes. An x-filename header works too.",
            "in": "query",
            "name": "filename",
            "required": true,
            "schema": {
              "maxLength": 255,
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "*/*": {
              "schema": {
                "format": "binary",
                "type": "string",
              },
            },
          },
          "description": "The file's bytes.",
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "filename": {
                      "type": "string",
                    },
                    "key": {
                      "type": "string",
                    },
                    "mimeType": {
                      "type": "string",
                    },
                    "sha256": {
                      "type": "string",
                    },
                    "size": {
                      "type": "number",
                    },
                  },
                  "required": [
                    "key",
                    "filename",
                    "mimeType",
                    "size",
                    "sha256",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Stored.",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "properties": {
                        "message": {
                          "type": "string",
                        },
                        "reason": {
                          "type": "string",
                        },
                      },
                      "type": "object",
                    },
                  },
                  "type": "object",
                },
              },
            },
            "description": "No filename, or an empty file.",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "properties": {
                        "message": {
                          "type": "string",
                        },
                        "reason": {
                          "type": "string",
                        },
                      },
                      "type": "object",
                    },
                  },
                  "type": "object",
                },
              },
            },
            "description": "No key, or not a key Mailyard knows.",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "properties": {
                        "message": {
                          "type": "string",
                        },
                        "reason": {
                          "type": "string",
                        },
                      },
                      "type": "object",
                    },
                  },
                  "type": "object",
                },
              },
            },
            "description": "No write access to the mailbox.",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "properties": {
                        "message": {
                          "type": "string",
                        },
                        "reason": {
                          "type": "string",
                        },
                      },
                      "type": "object",
                    },
                  },
                  "type": "object",
                },
              },
            },
            "description": "No such mailbox.",
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "properties": {
                        "message": {
                          "type": "string",
                        },
                        "reason": {
                          "type": "string",
                        },
                      },
                      "type": "object",
                    },
                  },
                  "type": "object",
                },
              },
            },
            "description": "Over 25 MiB.",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Upload an attachment for a draft",
        "tags": [
          "mail",
        ],
      },
    },
    "/v1/messages": {
      "get": {
        "operationId": "messages.list",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "enum": [
                "queued",
                "sent",
                "delivered",
                "deferred",
