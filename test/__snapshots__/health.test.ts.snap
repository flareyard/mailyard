                    "type": "string",
                  },
                  "type": "array",
                },
              ],
              "description": "[!]name[:days], repeatable, ANDed: the contact did the event (within the last 1–3650 days), or with a leading ! didn't.",
            },
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "enum": [
                "createdAt",
                "-createdAt",
                "email",
                "-email",
                "lastActivityAt",
