    "/v1/stats/{chart}.csv": {
      "get": {
        "description": "The same numbers as the chart's JSON endpoint. Charts: volume (by=day|hour), delivery (per day, with rates), providers, deferrals, engagement (campaigns), engagement-hours (weekday × UTC hour), unsubscribes (by topic), inbound, audience. Rates stay fractions; an empty cell means not enough data.",
        "operationId": "insights.csv",
        "parameters": [
          {
            "description": "Which chart.",
            "in": "path",
