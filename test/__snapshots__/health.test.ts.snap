    "/v1/suppressions/{email}": {
      "delete": {
        "operationId": "suppressions.remove",
        "parameters": [
          {
            "in": "path",
            "name": "email",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "confirm": {
                    "type": "boolean",
                  },
                },
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "cloudflare": {
                      "additionalProperties": false,
                      "description": "What happened on Cloudflare's list. removed: its entries for the address are gone. not-listed: it had none. read-only: Cloudflare keeps an entry nobody can delete, until it expires. not-connected: no write token, so Cloudflare may still refuse the address. failed: Cloudflare said no.",
                      "properties": {
                        "message": {
                          "anyOf": [
                            {
                              "type": "string",
                            },
                            {
                              "type": "null",
                            },
                          ],
                        },
                        "state": {
                          "enum": [
                            "removed",
                            "not-listed",
                            "read-only",
                            "not-connected",
                            "failed",
                          ],
                          "type": "string",
                        },
                      },
                      "required": [
                        "state",
                        "message",
                      ],
                      "type": "object",
                    },
                    "contactStatus": {
                      "anyOf": [
                        {
                          "type": "string",
                        },
                        {
                          "type": "null",
                        },
                      ],
                      "description": "The contact's status now: restored to what it was before the suppression.",
                    },
                    "email": {
                      "type": "string",
                    },
                    "removed": {
                      "type": "boolean",
                    },
                  },
                  "required": [
                    "email",
                    "removed",
                    "contactStatus",
                    "cloudflare",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Success",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidRequestEncoded",
                },
              },
            },
            "description": "InvalidRequest",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedEncoded",
                },
              },
            },
            "description": "Unauthorized",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForbiddenEncoded",
                },
              },
            },
            "description": "Forbidden",
          },
          "404": {
