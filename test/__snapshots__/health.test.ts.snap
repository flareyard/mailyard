                              "value",
                            ],
                            "type": "object",
                          },
                          "type": "array",
                        },
                        "terms": {
                          "items": {
                            "type": "string",
                          },
                          "type": "array",
                        },
                        "unsupported": {
                          "items": {
                            "additionalProperties": false,
                            "properties": {
                              "op": {
                                "type": "string",
                              },
                              "value": {
                                "type": "string",
                              },
                            },
                            "required": [
                              "op",
                              "value",
                            ],
                            "type": "object",
                          },
                          "type": "array",
                        },
                      },
                      "required": [
                        "operators",
                        "terms",
                        "unsupported",
                      ],
                      "type": "object",
                    },
                    "sort": {
                      "enum": [
                        "recent",
                        "relevance",
                      ],
                      "type": "string",
                    },
                    "threads": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "assignedTo": {
                            "anyOf": [
                              {
                                "additionalProperties": false,
                                "properties": {
                                  "id": {
                                    "type": "string",
                                  },
                                  "name": {
                                    "type": "string",
                                  },
                                },
                                "required": [
                                  "id",
                                  "name",
                                ],
                                "type": "object",
                              },
                              {
                                "type": "null",
                              },
                            ],
                            "description": "Who is handling it, with a name to show: the key's name until people exist (HAL-3361).",
                          },
                          "assignee": {
                            "anyOf": [
                              {
                                "type": "string",
                              },
                              {
                                "type": "null",
                              },
                            ],
                            "description": "The API key id handling it; see assignedTo for the name.",
                          },
                          "firstAt": {
                            "anyOf": [
                              {
                                "type": "number",
                              },
                              {
                                "enum": [
                                  "Infinity",
                                  "-Infinity",
                                  "NaN",
                                ],
                                "type": "string",
                              },
                            ],
                          },
                          "folders": {
                            "items": {
                              "enum": [
                                "inbox",
                                "archive",
                                "sent",
                                "spam",
                                "trash",
                                "snoozed",
                              ],
                              "type": "string",
                            },
                            "type": "array",
                          },
                          "hasAttachments": {
                            "type": "boolean",
                          },
                          "id": {
                            "type": "string",
                          },
                          "labelIds": {
                            "items": {
                              "type": "string",
                            },
                            "type": "array",
                          },
                          "lastAt": {
                            "anyOf": [
                              {
                                "type": "number",
                              },
                              {
                                "enum": [
                                  "Infinity",
                                  "-Infinity",
                                  "NaN",
                                ],
                                "type": "string",
                              },
                            ],
                          },
                          "latestMessageId": {
                            "type": "string",
                          },
                          "messageCount": {
                            "anyOf": [
                              {
                                "type": "number",
                              },
                              {
                                "enum": [
                                  "Infinity",
                                  "-Infinity",
                                  "NaN",
                                ],
                                "type": "string",
                              },
                            ],
                          },
                          "participants": {
                            "items": {
                              "additionalProperties": false,
                              "properties": {
                                "address": {
                                  "type": "string",
                                },
                                "name": {
                                  "anyOf": [
                                    {
                                      "type": "string",
                                    },
                                    {
                                      "type": "null",
                                    },
                                  ],
                                },
                              },
                              "required": [
                                "name",
                                "address",
                              ],
                              "type": "object",
                            },
                            "type": "array",
                          },
                          "scheduledSendAt": {
                            "anyOf": [
                              {
                                "anyOf": [
                                  {
                                    "type": "number",
                                  },
                                  {
                                    "enum": [
                                      "Infinity",
                                      "-Infinity",
                                      "NaN",
                                    ],
                                    "type": "string",
                                  },
                                ],
                              },
                              {
                                "type": "null",
                              },
                            ],
                            "description": "The earliest scheduled send of a reply in this conversation.",
                          },
                          "snippet": {
                            "type": "string",
                          },
                          "snoozedUntil": {
                            "anyOf": [
                              {
                                "anyOf": [
                                  {
                                    "type": "number",
                                  },
                                  {
                                    "enum": [
                                      "Infinity",
                                      "-Infinity",
                                      "NaN",
                                    ],
                                    "type": "string",
                                  },
                                ],
                              },
                              {
                                "type": "null",
                              },
                            ],
                          },
                          "sortAt": {
                            "anyOf": [
                              {
                                "type": "number",
                              },
                              {
                                "enum": [
                                  "Infinity",
                                  "-Infinity",
                                  "NaN",
                                ],
                                "type": "string",
                              },
                            ],
                          },
                          "spamScore": {
                            "anyOf": [
                              {
                                "anyOf": [
                                  {
                                    "type": "number",
                                  },
                                  {
                                    "enum": [
                                      "Infinity",
                                      "-Infinity",
                                      "NaN",
                                    ],
                                    "type": "string",
                                  },
                                ],
                              },
                              {
                                "type": "null",
                              },
                            ],
                            "description": "The highest spam score of its messages in spam; only when listing spam.",
