                      "items": {
                        "type": "string",
                      },
                      "type": "array",
                    },
                  ],
                },
                "description": "\`email\` (required), \`name\`, \`topics\` (topic ids, when the form lets the visitor pick), \`cf-turnstile-response\` (when the form has Turnstile), and the form's custom fields by key. \`_hp\` and \`website\` are honeypots and must stay empty.",
                "type": "object",
              },
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string",
                    },
                    {
                      "items": {
                        "type": "string",
                      },
                      "type": "array",
                    },
                  ],
                },
                "description": "\`email\` (required), \`name\`, \`topics\` (topic ids, when the form lets the visitor pick), \`cf-turnstile-response\` (when the form has Turnstile), and the form's custom fields by key. \`_hp\` and \`website\` are honeypots and must stay empty.",
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "enum": [
