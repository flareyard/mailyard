{
  "name": "mailyard-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fixtures": "VITE_FIXTURES=1 vite",
    "build": "tsc --noEmit -p . && vite build",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "api:types": "openapi-typescript ${MAILYARD_OPENAPI:-https://mailyard-api.halleluyaholudele.workers.dev/openapi.json} -o src/api/schema.d.ts",
