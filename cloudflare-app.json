        "source": "https://developers.cloudflare.com/workers/platform/pricing/",
        "measuredAt": "2026-10-17"
      },
      {
        "product": "D1",
        "unit": "row read",
        "included": "25 billion per month",
        "price": "$0.001 per million",
        "source": "https://developers.cloudflare.com/workers/platform/pricing/",
        "measuredAt": "2026-10-17"
      },
      {
        "product": "D1",
        "unit": "row written",
        "included": "50 million per month",
        "price": "$1.00 per million",
        "source": "https://developers.cloudflare.com/workers/platform/pricing/",
        "measuredAt": "2026-10-17"
      },
      {
        "product": "D1",
        "unit": "GB-month stored",
        "included": "5 GB",
        "price": "$0.75 per GB-month",
        "source": "https://developers.cloudflare.com/workers/platform/pricing/",
        "measuredAt": "2026-10-17"
      },
      {
        "product": "Queues",
        "unit": "operation",
        "included": "1 million per month",
        "price": "$0.40 per million",
        "source": "https://developers.cloudflare.com/workers/platform/pricing/",
        "measuredAt": "2026-10-17"
      },
      {
