{
  "manifestVersion": 1,
  "id": "mailyard",
  "name": "Mailyard",
  "description": "Inboxes, transactional email, contacts, campaigns and automations on your own Cloudflare account.",
  "version": "0.1.0",
  "stack": "wrangler.jsonc",
  "plan": "workers-paid",
  "scopes": {
    "required": [
      {
        "scope": "workers-scripts.write",
        "why": "Deploy Mailyard's Worker, with its Durable Objects (mailboxes, send pacing) and Workflows (imports, exports, campaign sends)"
      },
      {
        "scope": "d1.write",
        "why": "Store contacts, campaigns, templates and the delivery ledger"
      },
      {
        "scope": "workers-r2.write",
        "why": "Store raw messages, attachments, uploads and exports"
      },
      {
        "scope": "queues.write",
        "why": "Create the send, inbound and webhook queues, and subscribe delivery events for your sending domains"
      },
      {
        "scope": "email-sending.write",
        "why": "Send mail from your domains"
      },
      {
        "scope": "email-routing-rule.write",
        "why": "Route your domain's inbound mail to your Mailyard inboxes"
      }
    ],
    "optional": [
      {
        "scope": "zone.read",
        "why": "List your zones, so you can pick the domain to send and receive on",
        "enables": "domain"
      },
      {
        "scope": "dns.write",
        "why": "Write SPF, DKIM, DMARC and MX records, and turn on Email Routing for a receiving subdomain",
        "enables": "domain"
      }
    ]
  },
  "secrets": [
    {
      "name": "ADMIN_KEY",
      "generate": "random-32"
    },
    {
      "name": "UNSUBSCRIBE_KEY",
      "generate": "random-32"
    },
    {
      "name": "WEBHOOK_SIGNING_KEY",
      "generate": "random-32"
    },
    {
      "name": "FILE_SIGNING_KEY",
      "generate": "random-32"
    },
    {
      "name": "DEFAULT_FROM",
      "ask": "Sender used when a send names none, e.g. \"Acme <hello@acme.com>\"",
      "optional": true
    },
    {
      "name": "SMTP_PASSWORD",
      "ask": "Password for an SMTP mailbox used only as a fallback when Email Service is unavailable",
      "optional": true
    },
    {
      "name": "TURNSTILE_SECRET",
      "ask": "Cloudflare Turnstile secret key, so signup forms with a site key turn bots away",
      "help": "Cloudflare dashboard → Turnstile → your widget → Settings",
      "optional": true
    },
    {
      "name": "CLASSIFIER_API_KEY",
      "ask": "API key for the OpenAI-compatible spam classifier, if you turn it on",
      "optional": true
    },
    {
      "name": "CLOUDFLARE_ACCOUNT_ID",
      "ask": "Your Cloudflare account ID, so the Overview can show your daily sending quota and reputation",
      "optional": true
    },
    {
      "name": "CLOUDFLARE_EMAIL_READ_TOKEN",
      "ask": "A read-only API token with Email Sending: Read and Queues: Read, for the quota, reputation and delivery-events check",
      "optional": true
    },
    {
      "name": "CLOUDFLARE_EMAIL_WRITE_TOKEN",
      "ask": "An API token with Email Sending: Edit, so Mailyard can add to and remove from Cloudflare's suppression list",
      "optional": true
    }
  ],
  "settings": [
    {
      "name": "MAILYARD_UNDO_SECONDS",
      "label": "Undo send window",
      "type": "integer",
      "default": 10,
      "min": 0,
      "max": 30,
      "help": "Seconds a mailbox send waits so it can be undone. 0 sends at once."
    },
    {
      "name": "MAILYARD_TRACK_OPENS",
      "label": "Track opens in new campaigns",
      "type": "boolean",
      "default": true,
      "help": "A tracking pixel; Apple Mail's privacy proxy opens are counted apart. Each campaign can switch it off."
    },
    {
      "name": "MAILYARD_TRACK_CLICKS",
      "label": "Track clicks in new campaigns",
      "type": "boolean",
      "default": true,
      "help": "Links go through a redirect on your domain. Each campaign can switch it off."
    },
    {
      "name": "MAILYARD_CLASSIFIER",
      "label": "Spam classifier for inbound mail",
      "type": "enum",
      "default": "off",
      "options": [
        {
          "value": "off",
          "label": "Off"
        },
        {
          "value": "openai",
          "label": "An OpenAI-compatible endpoint"
        }
      ],
      "help": "Off keeps the rules-based checks (SPF, DKIM, DMARC and your rules)."
    },
    {
      "name": "CLASSIFIER_URL",
      "label": "Classifier endpoint",
      "type": "url",
      "optional": true,
      "when": {
        "setting": "MAILYARD_CLASSIFIER",
        "equals": "openai"
      },
      "help": "The chat completions URL, e.g. https://api.openai.com/v1/chat/completions"
    },
    {
      "name": "CLASSIFIER_MODEL",
      "label": "Classifier model",
      "type": "string",
      "optional": true,
      "when": {
        "setting": "MAILYARD_CLASSIFIER",
        "equals": "openai"
      }
    },
    {
      "name": "SMTP_HOST",
      "label": "Fallback SMTP host",
      "type": "string",
      "optional": true,
      "help": "Used only when Email Service is unavailable."
    },
    {
      "name": "SMTP_PORT",
      "label": "Fallback SMTP port",
      "type": "integer",
      "default": 465,
      "min": 1,
      "max": 65535
    },
    {
      "name": "SMTP_USERNAME",
      "label": "Fallback SMTP username",
      "type": "string",
      "optional": true
    }
  ],
  "domain": {
    "supported": true,
    "suggest": "mail"
  },
  "health": "/healthz",
  "status": {
    "path": "/v1/health",
    "auth": {
      "bearer": "ADMIN_KEY"
    }
  },
  "cost": {
    "typicalMonthlyUsd": "$5 Workers Paid minimum; light use (under 3,000 emails a month) stays inside it. Beyond that, see cost.units (Cloudflare pricing pages, 2026-10-17).",
    "units": [
      {
        "product": "Workers Paid",
        "unit": "account per month",
        "included": "Workers, KV, Hyperdrive and Durable Objects usage",
        "price": "$5 minimum",
        "source": "https://developers.cloudflare.com/workers/platform/pricing/",
        "measuredAt": "2026-10-17"
      },
      {
        "product": "Email Sending",
        "unit": "email",
        "included": "3,000 per month",
        "price": "$0.35 per 1,000",
        "source": "https://developers.cloudflare.com/email-service/platform/pricing/",
        "measuredAt": "2026-10-17"
      },
      {
        "product": "Email Routing",
        "unit": "inbound email",
        "included": "unlimited",
        "price": "free",
        "source": "https://developers.cloudflare.com/email-service/platform/pricing/",
        "measuredAt": "2026-10-17"
      },
      {
        "product": "Workers",
        "unit": "request",
        "included": "10 million per month",
        "price": "$0.30 per million",
        "source": "https://developers.cloudflare.com/workers/platform/pricing/",
        "measuredAt": "2026-10-17"
      },
      {
